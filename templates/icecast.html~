<!DOCTYPE html>
<html>
<head>
    <title>Live Stream Transcriber</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f7fafc; }
    </style>
</head>

<body class="p-4 sm:p-8">

    <div class="max-w-4xl mx-auto bg-white p-6 md:p-10 rounded-xl shadow-2xl">
        <h1 class="text-3xl font-extrabold text-gray-800 mb-6 border-b pb-4">Live Stream Transcription (Icecast)</h1>
        
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <ul class="mb-4">
                {% for category, message in messages %}
                    <li class="p-3 mb-2 rounded-lg text-sm {% if category == 'error' %}bg-red-100 text-red-700{% elif category == 'warning' %}bg-yellow-100 text-yellow-700{% else %}bg-green-100 text-green-700{% endif %}">
                        {{ message }}
                    </li>
                {% endfor %}
                </ul>
            {% endif %}
        {% endwith %}

        <p class="mb-6 text-sm text-gray-600">
            This feature starts a background worker that attempts to read an Icecast stream. The process is simplified here: a real implementation requires a streaming-capable Whisper library (not the CLI) and complex audio chunking. 
            The stream's URL is currently set in <code>config.py</code>.
        </p>

        <form method="POST" action="{{ url_for('icecast_interface') }}" class="space-y-4 mb-8">
            <button type="submit" 
                    class="px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg shadow-md hover:bg-indigo-700 transition duration-150">
                Start Live Transcription
            </button>
        </form>
        
        <a href="{{ url_for('upload_and_list') }}" class="mt-8 inline-block px-4 py-2 bg-gray-200 text-gray-700 font-semibold rounded-lg shadow-md hover:bg-gray-300 transition duration-150">
            &larr; Back to Recordings List
        </a>
    </div>

</body>
</html>
