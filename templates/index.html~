<!DOCTYPE html>
<html>
<head>
    <title>Translator & Transcriber</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f7fafc; }
        .status-pending { color: #f97316; } /* orange-600 */
        .status-processing { color: #2563eb; } /* blue-600 */
        .status-done { color: #10b981; } /* emerald-500 */
        .status-error { color: #ef4444; } /* red-500 */
        /* Custom dropdown styles for the Reprocess button */
        .dropdown-menu {
            display: none;
            position: absolute;
            z-index: 10;
        }
        .dropdown:hover .dropdown-menu,
        .dropdown.open .dropdown-menu {
            display: block;
        }
    </style>
</head>

<body class="p-4 sm:p-8">

    <div class="max-w-6xl mx-auto bg-white p-6 md:p-10 rounded-xl shadow-2xl">
        
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <ul class="mb-6">
                {% for category, message in messages %}
                    <li class="p-4 rounded-lg text-sm mb-2 {% if category == 'error' %}bg-red-100 text-red-700{% elif category == 'warning' %}bg-yellow-100 text-yellow-700{% else %}bg-green-100 text-green-700{% endif %}">
                        {{ message }}
                    </li>
                {% endfor %}
                </ul>
            {% endif %}
        {% endwith %}

        <div class="flex justify-between items-center border-b pb-4 mb-6">
            <h1 class="text-4xl font-extrabold text-gray-800">Whisper Transcriber</h1>
            <div class="flex space-x-4 items-center">
                <a href="{{ url_for('logout') }}" 
                   class="px-4 py-2 bg-gray-600 text-white font-semibold rounded-lg shadow-md hover:bg-gray-700 transition duration-150">
                    Logout
                </a>
                <a href="{{ url_for('cleanup') }}" 
                   class="px-4 py-2 bg-yellow-500 text-white font-semibold rounded-lg shadow-md hover:bg-yellow-600 transition duration-150"
                   onclick="return confirm('Are you sure you want to run the Zombie Cleanup? This removes all database entries where the audio file is missing on disk.')">
                    Clean Zombie Files
                </a>
            </div>
        </div>

        <form method="POST" enctype="multipart/form-data" class="mb-8 p-6 border border-gray-200 rounded-lg shadow-inner bg-gray-50">
            <h2 class="text-2xl font-semibold text-gray-700 mb-4">Upload Audio/Video</h2>
            <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4 items-center">
                <input type="file" name="file" required 
                       class="w-full sm:w-1/2 p-2 border border-gray-300 rounded-lg bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 transition duration-150">
                
                <select name="model_key" id="model_key" 
                        class="w-full sm:w-auto px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 bg-white text-gray-700">
                    {% for key, model_info in models.items() %}
                        <option value="{{ key }}" {% if key == default_model %}selected{% endif %}>
                            {{ model_info.name }} ({{ model_info.size }})
                        </option>
                    {% endfor %}
                </select>
                
                <button type="submit" 
                        class="w-full sm:w-auto px-6 py-2 bg-indigo-600 text-white font-semibold rounded-lg shadow-md hover:bg-indigo-700 transition duration-150">
                    Upload & Transcribe
                </button>
            </div>
        </form>

        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Current Recordings</h2>

        {% if recordings %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 shadow-lg rounded-lg">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Filename</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Model</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for recording in recordings %}
                        <tr id="rec-{{ recording.id }}" 
                            data-status="{{ recording.status }}" 
                            data-polling="true"
                            class="hover:bg-gray-50 transition duration-150">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ recording.id }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ recording.filename }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ models.get(recording.model_key, {'name': 'Unknown'}).name }}</td>
                            <td id="status-{{ recording.id }}" 
                                class="px-6 py-4 whitespace-nowrap text-sm font-semibold status-{{ recording.status }}">
                                {{ recording.status.capitalize() }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <div class="flex space-x-2 justify-center">
                                    {% if recording.status == 'done' %}
                                        <a href="{{ url_for('view_transcript', rec_id=recording.id) }}" 
                                           class="text-indigo-600 hover:text-indigo-900 transition duration-150 font-medium">
                                            View
                                        </a>
                                        <div class="relative inline-block text-left dropdown group">
                                            <button type="button" class="text-sm text-blue-600 hover:text-blue-900 font-medium px-2" aria-expanded="true" aria-haspopup="true">
                                                Reprocess
                                            </button>
                                            <div class="dropdown-menu origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none hidden group-hover:block group-focus-within:block" role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1">
                                                <div class="py-1" role="none">
                                                    {% for key, model_info in models.items() %}
                                                        <a href="{{ url_for('reprocess', model_key=key, rec_id=recording.id) }}" 
                                                           class="text-gray-700 block px-4 py-2 text-sm hover:bg-gray-100" 
                                                           role="menuitem" tabindex="-1"
                                                           onclick="return confirm('Reprocess ID {{ recording.id }} with model: {{ model_info.name }}?')">
                                                            Model: {{ model_info.name }}
                                                        </a>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <span class="text-gray-400">View</span>
                                        <span class="text-gray-400">Reprocess</span>
                                    {% endif %}
                                    <a href="{{ url_for('delete', rec_id=recording.id) }}" 
                                       class="text-red-600 hover:text-red-900 transition duration-150 font-medium px-2"
                                       onclick="return confirm('Are you sure you want to delete recording ID {{ recording.id }}?')">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-gray-500 p-4 border border-gray-100 rounded-lg bg-white">No recordings found. Upload an audio or video file to begin transcription.</p>
        {% endif %}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            // Function to fetch and update status
            const updateStatus = async (recId) => {
                const statusElement = document.getElementById(`status-${recId}`);
                const row = document.getElementById(`rec-${recId}`);
                
                if (!statusElement || !row) return;

                try {
                    const response = await fetch(`{{ url_for('recording_status', rec_id=0) }}`.replace('0', recId));
                    const data = await response.json();
                    const newStatus = data.status;
                    
                    // Only update if status has changed
                    if (newStatus !== row.dataset.status) {
                        row.dataset.status = newStatus;
                        statusElement.textContent = newStatus.charAt(0).toUpperCase() + newStatus.slice(1);
                        
                        // Clear all status classes and apply the new one
                        statusElement.className = statusElement.className.replace(/\bstatus-\S+/g, '');
                        statusElement.classList.add(`status-${newStatus}`);
                        
                        // If done or error, stop polling and refresh for action links
                        if (newStatus === 'done' || newStatus.startsWith('error')) {
                            row.dataset.polling = "false";
                            // A full page refresh is necessary to show the View/Reprocess buttons
                            window.location.reload(); 
                        }
                    }
                } catch (error) {
                    // Stop polling and mark status as unknown/error in the UI
                    row.dataset.polling = "false";
                }
            }

            // Poll every 5 seconds for pending/processing recordings
            setInterval(() => {
                document.querySelectorAll("tr[id^='rec-']").forEach(row => {
                    const status = row.dataset.status;
                    const isPolling = row.dataset.polling === "true"; 

                    if (isPolling && (status === 'pending' || status === 'processing')) {
                        const recId = parseInt(row.id.replace('rec-', ''));
                        if (!isNaN(recId)) {
                            updateStatus(recId);
                        }
                    }
                });
            }, 5000);
            
            // Re-apply dropdown hover/click functionality
            document.querySelectorAll('.dropdown').forEach(dropdown => {
                dropdown.addEventListener('click', (e) => {
                    // Toggle 'open' class for click support on touch devices
                    dropdown.classList.toggle('open');
                });
            });
            // Close dropdowns when clicking outside
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.dropdown')) {
                    document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('open'));
                }
            });
        });
    </script>
</body>
</html>